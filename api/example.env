# ---- api LOCAL env ----  copy to: api/.env
# When running via docker compose, MONGODB_URI is overridden to mongodb://mongo:27017/startuphealer
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/startuphealer

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=1

# First admin account — created automatically on boot if it doesn't exist
ADMIN_NAME=StartupHealer Admin
ADMIN_EMAIL=admin@startuphealer.com
ADMIN_PASSWORD=Admin@12345

WHATSAPP_NUMBER=919610332259
