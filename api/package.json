{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "description": "StartupHealer REST API (Express + MongoDB)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "seed:admin": "node --env-file-if-exists=.env src/scripts/seedAdmin.js",
    "lint": "node --check src/server.js"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "zod": "^4.6.7"
  }
}
