# ---- web (Next.js) env ----  copy to: web/.env.local
# Server-side only: where Next.js proxies /api/v1/* requests.
#   local (docker api):  http://localhost:5000
#   production (Vercel): https://startuphealer-api.onrender.com
API_URL=http://localhost:5000

# Public site URL — used for canonical URLs, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google Search Console verification token & GA4 id
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_ID=
